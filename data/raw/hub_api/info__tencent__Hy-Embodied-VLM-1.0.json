{"_fetched_at": "2026-10-10T11:07:04+00:00", "_id": "6a560840b1cb3ec9de79d29c", "author": "tencent", "cardData": {"language": ["en", "zh"], "library_name": "transformers", "license": "apache-2.0", "pipeline_tag": "image-text-to-text", "tags": ["embodied-ai", "vision-language-model", "robotics", "spatial-reasoning", "multimodal", "moe", "vllm"]}, "config": {"architectures": ["HYV3VLForConditionalGeneration"], "auto_map": {"AutoConfig": "configuration_hy_v3_vl.HYV3VLConfig", "AutoImageProcessor": "image_processing_hunyuan_vl.HunYuanVLImageProcessor", "AutoModel": "modeling_hy_v3_vl.HYV3VLModel", "AutoModelForCausalLM": "modeling_hy_v3_vl.HYV3VLForCausalLM", "AutoModelForImageTextToText": "modeling_hy_v3_vl.HYV3VLForConditionalGeneration", "AutoProcessor": "processing_hy_v3_vl.HYV3VLProcessor", "AutoVideoProcessor": "video_processing_hy_v3_vl.HYV3VLVideoProcessor"}, "chat_template_jinja": "{#\n  Hy-Embodied-VLM-1.0 unified chat template\n\n  Toggles between chain-of-thought \"think\" mode and direct \"no-think\" mode via\n  the `enable_thinking` kwarg (Qwen3 convention).\n\n    enable_thinking=True  (default) \u2192 emit '<think>' (model does CoT then answers)\n    enable_thinking=False           \u2192 emit '<think></think>' (model answers directly)\n\n  We deliberately do NOT use `reasoning_effort` as the kwarg name. vLLM prior to\n  v0.22 has a top-level `request.reasoning_effort` field (defaults to None) that\n  silently overwrites `chat_template_kwargs[\"reasoning_effort\"]` at request\n  parsing time (fixed by vllm-project/vllm#43401). Using `enable_thinking`\n  side-steps that clobber entirely.\n\n  Usage (OpenAI-compatible client):\n    client.chat.completions.create(\n        model=\"hy_a3b\",\n        messages=[...],\n        extra_body={\"chat_template_kwargs\": {\"enable_thinking\": False}},\n    )\n\n  The prompt-side tokens (`reasoning_effort:high` / `reasoning_effort:no_think`\n  in the system prefix + `<think>` / `<think></think>` at the assistant prefix)\n  are unchanged from the M4-validated split templates\n  (chat_template.jinja fb335d + chat_template_nothink.jinja bee6957) \u2014 so\n  model behaviour is byte-equivalent to the evaluation-time posture.\n#}\n{%- set bos_token = '<\uff5chy_begin\u2581of\u2581sentence\uff5c>' %}\n{%- set user_token = '<\uff5chy_User\uff5c>' %}\n{%- set assistant_token = '<\uff5chy_Assistant\uff5c>' %}\n{%- set reasoning_mode_token = '<\uff5creasoning_mode\uff5c>' %}\n{%- set image_start_token = '<\uff5chy_image\u2581start\uff5c>' %}\n{%- set image_pad_token = '<\uff5chy_image\u2581pad\uff5c>' %}\n{%- set image_end_token = '<\uff5chy_image\u2581end\uff5c>' %}\n{%- if enable_thinking is not defined %}\n{%-   set enable_thinking = true %}\n{%- endif %}\n{{- bos_token }}\n{{- reasoning_mode_token + 'reasoning_effort:' + ('high' if enable_thinking else 'no_think') }}\n{%- for message in messages %}\n{%- if message['role'] == 'user' %}\n{{- user_token }}\n{%- if message['content'] is string %}\n{{- message['content'] }}\n{%- else %}\n{%- for item in message['content'] %}\n{%- if 'image' in item or 'image_url' in item or item.type == 'image' %}\n{{- image_start_token + image_pad_token + image_end_token }}\n{%- elif 'text' in item %}\n{{- item.text }}\n{%- endif %}\n{%- endfor %}\n{%- endif %}\n{%- endif %}\n{%- endfor %}\n{{- assistant_token + '<think>' }}\n{%- if not enable_thinking %}\n{{- '</think>' }}\n{%- endif %}\n", "model_type": "hy_v3_vl", "num_experts": 128, "num_experts_per_tok": 8, "tokenizer_config": {"bos_token": "<\uff5chy_begin\u2581of\u2581sentence\uff5c>", "eos_token": "<eos:6124c78e>", "pad_token": "<\uff5chy_\u2581pad\u2581\uff5c>"}}, "createdAt": "2026-07-14T09:58:24.000Z", "disabled": false, "downloads": 649, "gated": false, "id": "tencent/Hy-Embodied-VLM-1.0", "lastModified": "2026-07-15T02:53:49.000Z", "library_name": "transformers", "likes": 26, "model-index": null, "modelId": "tencent/Hy-Embodied-VLM-1.0", "pipeline_tag": "image-text-to-text", "private": false,